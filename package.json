{
  "name": "edudesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run --hot server/index.ts",
    "build": "bun run scripts/build.ts",
    "start": "NODE_ENV=production sh -c 'cd dist && bun index.js'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests",
    "test:unit": "bun test tests",
    "test:coverage": "bun test tests --coverage",
    "test:e2e": "playwright test",
    "test:double-instance": "bun run tests/double-instance.ts",
    "db:migrate": "bun run db/migrate.ts",
    "db:rollback": "bun run db/migrate.ts down",
    "db:seed": "bun run db/seed.ts",
    "storage:cleanup": "bun run scripts/cleanup-files.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.102.3",
    "better-auth": "^1.7.1",
    "hono": "^4.13.4",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/bun": "1.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "typescript": "7.0.2"
  }
}
